{
    "manifest_version": 3,
    "name": "Analysis Control",
    "version": "0.4.0",
    "description": "Ferramenta para inspeção e automação do BSIT.",
    "permissions": [
        "activeTab",
        "alarms",
        "notifications",
        "sidePanel",
        "scripting",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "http://jatai.bsit-br.com.br/*",
         "https://jatai.sigep.com.br/*"
    ],
    "icons": {
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Analysis Control",
        "default_icon": {
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "http://jatai.bsit-br.com.br/*",
                 "https://jatai.sigep.com.br/*"
            ],
            "js": [
                "js/core/storage.js",
                "js/core/apiClient.js",
                "js/core/distribution.js",
                "js/bsit/inspector.js",
                "js/bsit/notificacoes.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}